root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[{docs/research/rxp-samples/*-crlf.txt,tests/fixtures/rxp/*-crlf.txt}]
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = unset
