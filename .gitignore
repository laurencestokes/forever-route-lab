# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/

# Local caches (upstream clones, downloads). Never committed.
.cache/

# Raw local map exports from a developer's own WoW client (see docs/MAPS.md).
# Game artwork is NOT redistributed from this repository.
assets-source/*
!assets-source/README.md

# public/maps holds only the committed outputs: the placeholder geometry (D-018), the painted map
# art (D-033) and the terrain byproducts (D-032), each with its manifest and NOTICE. Local map
# outputs go to local-maps/ (outside public/, D-018), never here.
public/maps/*
!public/maps/placeholder/
!public/maps/art/
!public/maps/terrain/

# Extraction reports (timings, full input lists): not committed (ARCHITECTURE §5.2).
generated/questiedb-report.json
generated/terrain-nav-report*.json
generated/maps-art-report.json
generated/terrain-report.json

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
pnpm-debug.log*

# Local env
.env
.env.*
!.env.example

# Local map sets (art and extra geometry) from your own client. Never committed or deployed (D-018).
local-maps/*
!local-maps/README.md
